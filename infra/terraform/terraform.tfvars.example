# Copy this file to terraform.tfvars and fill in your values
# terraform.tfvars is gitignored

project_id  = "your-gcp-project-id"
region      = "us-central1"
github_repo = "your-username/ai-ensemble-8"

# Monitoring (optional; see docs/DEPLOYMENT.md). Leave empty to skip.
