rules_version = '2';

// Ensemble AI Firestore rules.
//
// The server (firebase-admin) writes every document and is not bound by
// these rules. Clients never write. A signed-in user may read their own
// user document, credit ledger entries and usage records, and nothing else.
// Collections not listed here (stripeEvents and any later ones) are closed.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /creditLedger/{entryId} {
      // A list query must filter on uid == request.auth.uid to pass.
      allow read: if ownsExisting();
      allow write: if false;
    }

    match /usage/{usageId} {
      allow read: if ownsExisting();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
