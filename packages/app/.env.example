# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

# Sentry error monitoring (optional — omit to disable)
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# Set to "false" to suppress handled tRPC application errors.
# Default behavior captures handled + unhandled tRPC errors in Sentry.
# SENTRY_CAPTURE_HANDLED_TRPC_ERRORS="false"

# Firebase Auth backend verification (required for Pro mode auth-gated tRPC routes)
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Auth on the client (Google and email link sign-in). Public web
# config from the Firebase console. Leave unset to run in Free or mock mode:
# the account menu then says sign-in is not set up. See docs/DEPLOYMENT.md.
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# Offer Pro mode (needs sign-in plus the Stripe and OpenRouter server keys).
# NEXT_PUBLIC_PRO_ENABLED="true"
# Local tests: point the client and firebase-admin at the emulators.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Credits (Pro mode). Balances are integer micro-dollars; these are in USD.
# CREDIT_MARGIN_PERCENT="30"       # charged over model cost
# CREDIT_LOW_BALANCE_USD="1"       # low-balance warning threshold (FR-038)
# CREDIT_PACKS_USD="5,20,50"       # Stripe Checkout packs

# Stripe (test mode keys while testing: sk_test_..., whsec_...)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# Public origin for the Checkout return links, when the request origin is not it.
# APP_URL="https://your-app.hosted.app"

# Server-side provider keys for auth-gated backend provider routes (Pro mode)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_API_KEY=""
# XAI_API_KEY=""
# DEEPSEEK_API_KEY=""
# PERPLEXITY_API_KEY=""

# Backend provider integration test configuration (optional)
# TEST_FIREBASE_WEB_API_KEY=""
# TEST_FIREBASE_AUTH_EMAIL="backend-integration-test@example.com"
# TEST_FIREBASE_AUTH_PASSWORD=""
# TEST_BACKEND_PROVIDER="openai"
# TEST_BACKEND_MODEL="gpt-6-luna"
