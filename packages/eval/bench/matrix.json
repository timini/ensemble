{
  "name": "m3-matrix",
  "description": "Three open 7B to 14B models from different families, alone and as an ensemble, against one premium reference. Model ids and prices checked against https://openrouter.ai/api/v1/models on 2026-11-17.",
  "datasets": [
    "gsm8k",
    "mmlu_pro",
    "gpqa",
    "truthfulqa"
  ],
  "sample": 200,
  "questionSeed": 42,
  "optionSeed": 1729,
  "protocol": "structured",
  "temperature": 0,
  "models": [
    {
      "id": "qwen",
      "label": "Qwen3.5 9B",
      "spec": "openrouter:qwen/qwen3.5-9b"
    },
    {
      "id": "llama",
      "label": "Llama 3.1 8B Instruct",
      "spec": "openrouter:meta-llama/llama-3.1-8b-instruct"
    },
    {
      "id": "gemma",
      "label": "Gemma 3 12B",
      "spec": "openrouter:google/gemma-3-12b-it"
    }
  ],
  "summarizer": "qwen",
  "ensembleStrategies": [
    "majority",
    "standard"
  ],
  "reference": {
    "id": "reference",
    "label": "Claude Sonnet 5.5",
    "spec": "openrouter:anthropic/claude-sonnet-5.5",
    "routing": {
      "ignore": [
        "claude-on-aws"
      ]
    }
  },
  "budgetUsd": 20,
  "questionTimeoutMs": 900000,
  "callTimeoutMs": 180000,
  "consensusTimeoutMs": 300000,
  "maxRetries": 4
}
