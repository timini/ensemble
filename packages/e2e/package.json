{
    "name": "@ai-ensemble/e2e",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "test:e2e": "playwright test",
        "test:ui": "playwright test --ui",
        "test:mock": "cross-env E2E_MODE=mock playwright test --project=mock-mode --project=local-endpoint",
        "test:free": "cross-env E2E_MODE=free playwright test --project=free-mode",
        "test:pro": "firebase emulators:exec --only auth,firestore --project demo-ensemble \"cross-env E2E_MODE=pro playwright test --project=pro-mode\"",
        "test:local-endpoint": "cross-env E2E_MODE=mock playwright test --project=local-endpoint",
        "fake-openai": "node fixtures/fake-openai-server.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@playwright/test": "^1.55.1",
        "@types/node": "^20.14.10",
        "cross-env": "^7.0.3",
        "dotenv": "^17.2.3",
        "stripe": "^23.1.0",
        "typescript": "^5.8.2"
    }
}
